CLAWPI_SERVER_URL=https://api.example.com
# WPA hotspot password: 8-63 characters and unique per device.
CLAWPI_SETUP_PASSWORD=replace-with-per-device-password
CLAWPI_WIFI_INTERFACE=wlan0
CLAWPI_STATE_DIR=/var/lib/clawpi
PI_CODING_AGENT_DIR=/var/lib/clawpi/pi-config

# App normally configures these values after the host comes online.
# These remain available as factory/development fallbacks.
CLAWPI_PI_PROVIDER=
CLAWPI_PI_MODEL=
CLAWPI_PI_THINKING=medium

# Optional development fallback. Production keys are stored in
# /var/lib/clawpi/agent.json after configuration from the App.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
